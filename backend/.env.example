# Database
database_url=postgresql+asyncpg://postgres:password@localhost:5432/modernbazaar

# JWT
secret_key=change-this-to-a-long-random-secret-key-at-least-32-chars
algorithm=HS256
access_token_expire_minutes=60
refresh_token_expire_days=7

# App
app_name=ModernBazaarHO
app_version=1.0.0
debug=true
allowed_origins=http://localhost:5173,http://localhost:3000
legacy_mssql_password=change-me
